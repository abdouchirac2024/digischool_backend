# ==============================================
# CONFIGURATION ENVIRONNEMENT - DIGISCHOOL BACKEND
# ==============================================
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env

# -------------------------
# Base de données
# -------------------------
DB_URL=jdbc:mysql://localhost:3306/school_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=digischool_user
DB_PASSWORD=root

# -------------------------
# JWT (CRITIQUE - à changer en production)
# -------------------------
# Générer avec: openssl rand -base64 64
JWT_SECRET=votre_secret_jwt_256_bits_minimum_ici
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# -------------------------
# JPA / Hibernate
# -------------------------
# Production: validate | Dev: update
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
